# Gardena/Husqvarna API Credentials
# Aus https://developer.husqvarnagroup.cloud/
GARDENA_CLIENT_ID=dein-client-id-hier
GARDENA_CLIENT_SECRET=dein-client-secret-hier

# Gardena Customer-Login (fuer DHS-Backfill ueber smart.gardena.com, T-0055)
# Derselbe Account wie in der Gardena-App / unter https://smart.gardena.com/
# Wird NUR verwendet um Bewaesserungs-Historie (inoffizieller /v1/dhs-Endpoint)
# abzurufen. Das Developer-API (CLIENT_ID/SECRET oben) bleibt der Haupt-Auth-Pfad
# fuer Live-Steuerung ueber api.smart.gardena.dev.
GARDENA_CUSTOMER_EMAIL=deine-gardena-app-mail@example.com
GARDENA_CUSTOMER_PASSWORD=dein-gardena-app-passwort

# iMessage-Empfaenger fuer Giess-Erinnerungen
IMESSAGE_EMPFAENGER=+49...

# Standort fuer Wettervorhersage (Breitengrad, Laengengrad)
# Beispielwerte (Berlin Mitte). Durch eigene Koordinaten ersetzen.
WETTER_BREITE=52.5200
WETTER_LAENGE=13.4050

# FYTA Pflanzensensoren
# Ab T-0072 (2026-04-23) bevorzugt: Email + Passwort deines FYTA-Accounts
# (web.fyta.de bzw. FYTA-App-Login). Das Backend holt sich damit bei Start
# und auf 401/403 automatisch ein frisches Access-Token und cached es in
# backend/daten/fyta_customer_token.json. Kein manueller Token-Refresh
# aus LocalStorage mehr noetig.
FYTA_EMAIL=deine-fyta-mail@example.com
FYTA_PASSWORD=dein-fyta-passwort

# Optional: alter Pfad (falls FYTA_EMAIL/FYTA_PASSWORD nicht gesetzt werden).
# LocalStorage-Token aus web.fyta.de, laeuft nach ~2 Wochen ab. Seit T-0072
# nur noch als Override/Backward-Compat — neue Installation: oben Email+PW.
# FYTA_ACCESS_TOKEN=dein-fyta-token-hier
